# Matrix store: "memory" (default, single worker) or "redis" (multi-worker)
RXD_STORE_BACKEND=memory
RXD_REDIS_URL=redis://localhost:6379/0
RXD_STORE_MAX_ITEMS=256
RXD_STORE_TTL_SECONDS=3600

# Request caps. Every endpoint is synchronous CPU work; these keep one request
# from occupying a worker for minutes.
RXD_MAX_NODE_COUNT=2000
RXD_MAX_SEQUENCE_LENGTH=20000
RXD_MAX_ITERATIONS=32
RXD_MAX_NULL_ITERATIONS=500
RXD_MAX_TASKS=4
RXD_MAX_RATIOS=10

RXD_CORS_ORIGINS=*

# Base URL advertised in the OpenAPI servers block. Set this to your public
# deployment URL before exporting openapi.json for an API hub.
RXD_PUBLIC_URL=http://localhost:8080
